# Public site URL (used for canonical URLs, sitemap, RSS and social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public: safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server only, optional). Bypasses RLS for editor writes.
# If unset, writes use the editor's session and need RLS policies for authenticated editors.
SUPABASE_SERVICE_ROLE_KEY=

# CMS access: comma-separated emails of Supabase Auth users allowed to edit content.
# Empty means nobody can access /cms or write endpoints.
CMS_ALLOWED_EMAILS=

# Market data
FINNHUB_API_KEY=

# n8n content pipeline (server only)
N8N_MCP_TOKEN=
# N8N_MCP_URL=
# N8N_WORKFLOW_ID=

# Optional calls to action on the home page (hidden when empty)
NEXT_PUBLIC_VIP_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# Used by opencode.json (Stitch MCP)
STITCH_API_KEY=
